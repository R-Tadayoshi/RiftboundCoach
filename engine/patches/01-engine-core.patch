+///
+/// The engine pays energy in several places (play costs, activation costs,
+/// additional costs) and none of them is reachable from a CardContext, so
+/// cards that offer an optional energy payment mid-effect had nowhere to go.
+///
+/// Exhausts ready runes in the player's base, which is what paying energy
+/// IS (CR 164.2.a) — as against power, which recycles an already-exhausted
+/// one. Returns false and exhausts nothing when the player cannot cover the
+/// whole cost, so a partial payment can never happen.
+inline bool payEnergyFromRunes(CardContext& ctx, int amount) {
+    if (amount <= 0) return true;
+    const auto base = BaseLocation{ctx.controller};
+
+    std::vector<GameObjectId> ready;
+    for (auto& [id, obj] : ctx.state.objects) {
+        if (!obj.isRune() || obj.controller != ctx.controller) continue;
+        if (obj.is_exhausted) continue;
+        if (!obj.location.has_value() || *obj.location != LocationId{base}) continue;
+        ready.push_back(id);
+    }
+    if (static_cast<int>(ready.size()) < amount) return false;
+
+    for (int i = 0; i < amount; ++i) {
+        ctx.state.getObject(ready[i]).is_exhausted = true;
+    }
+    return true;
+}
+
+/// "If you control fewer runes than an opponent" — the VEN catch-up clause
+/// (Forsaken Baccai, Oasis Raider, and the [Empower] discounts that scale
+/// with rune count).
+///
+/// Runes ON THE BOARD that you control. A rune in hand is not one you
+/// control, and an exhausted rune still is — the clause counts how many you
+/// have, not how many you can spend, which is the same distinction that
+/// makes power cost recycle an exhausted rune rather than exhaust a ready
+/// one.
+///
+/// "Fewer than AN opponent" is fewer than any single one of them, so a strict
+/// comparison against each in turn rather than against their total.
+inline int runesControlled(const GameState& state, PlayerId player) {
+    int n = 0;
+    for (const auto& [id, obj] : state.objects) {
+        if (!obj.isRune() || obj.controller != player) continue;
+        if (!obj.location.has_value()) continue;
+        ++n;
+    }
+    return n;
+}
+
+inline bool behindOnRunes(const GameState& state, PlayerId player) {
+    const int mine = runesControlled(state, player);
+    for (auto p : {PlayerId::Player1, PlayerId::Player2}) {
+        if (p == player) continue;
+        if (mine < runesControlled(state, p)) return true;
+    }
+    return false;
+}
+
+// ── [Empower] / [Empowered] / Disempower (VEN) ───────────────────────────
+//
+// Three printed things, one latch (GameObject::is_empowered):
+//
+//   [Empower] <cost>       an activated ability: pay it, become Empowered.
+//                          "Use only if not Empowered."
+//   [Empowered][>] <text>  an ability that only works while the latch is set,
+//                          or a clause that reads differently while it is.
+//   Disempower this, <cost>: <effect>
+//                          an activated ability whose cost includes clearing
+//                          the latch — so it is legal only while set.
+//
+// The legality halves are why Card::canActivateAbility grew a per-object,
+// per-ability overload: "use only if not Empowered" is about THIS copy of the
+// card and THIS one of its abilities, and the card-wide form could express
+// neither. Cards using these helpers override that overload and answer from
+// empowerGate().
+
+inline bool isEmpowered(const GameState& state, GameObjectId id) {
+    return state.objectExists(id) && state.getObject(id).is_empowered;
+}
+
+/// Set the latch. Idempotent by the rules' own wording — "It becomes
+/// Empowered if it's not already" — so empowering twice is not an error and
+/// must not be logged as one.
+inline void empowerObject(CardContext& ctx, GameObjectId id) {
+    if (!ctx.state.objectExists(id)) return;
+    auto& obj = ctx.state.getObject(id);
+    if (obj.is_empowered) return;
+    obj.is_empowered = true;
+    ctx.events.logTrace("EMPOWER: " + obj.name + " (id=" + std::to_string(id) +
+                         ") is now Empowered");
+    // CR 441.2.a — becoming Empowered is an event. Emitted only on the
+    // transition: the early return above means empowering something already
+    // Empowered fires nothing, so "when you empower something else" cannot
+    // be farmed by re-empowering.
+    ctx.events.emit(ObjectEmpoweredEvent{id, ctx.controller});
+}
+
+inline void disempowerObject(CardContext& ctx, GameObjectId id) {
+    if (!ctx.state.objectExists(id)) return;
+    auto& obj = ctx.state.getObject(id);
+    if (!obj.is_empowered) return;
+    obj.is_empowered = false;
+    ctx.events.logTrace("DISEMPOWER: " + obj.name + " (id=" + std::to_string(id) + ")");
+}
+
+/// The [Empower] ability's descriptor: pay the cost, become Empowered.
+inline ActivatedAbility empowerAbility(ActivationCost cost) {
+    ActivatedAbility ab;
+    ab.cost = cost;
+    return ab;
+}
+
+/// The shared answer to "may this ability be activated on this object?" for a
+/// card laid out as { [Empower], then the rest }.
+///
+/// `empower_index` is which ability is the [Empower] one; `requires_empowered`
+/// lists the ability indices that only exist while the latch is set — both the
+/// "[Empowered][>] …" kind, which leaves it set, and the "Disempower this, …"
+/// kind, which clears it in onActivate. Everything else is unconditional.
+inline bool empowerGate(const GameState& state, GameObjectId self,
+                        int ability_index, int empower_index,
+                        std::initializer_list<int> requires_empowered) {
+    const bool on = isEmpowered(state, self);
+    if (ability_index == empower_index) return !on;   // 441.1.b
+    for (int i : requires_empowered) if (ability_index == i) return on;
+    return true;
+}
+
+/// The commonest VEN unit: `[Empower] <cost>` plus `[Empowered][>] I have
+/// <something>`.
+///
+/// Winding it up is its only activated ability, and the payoff is a passive
+/// that holds while the latch is set. Subclasses give the cost and the buff;
+/// everything else — the ability descriptor, CR 441.1.b's "an Empowered Game
+/// Object can not be Empowered", the per-object aura — is the same on every
+/// one of them and belongs here rather than in thirty files.
+///
+/// A card that ALSO has other abilities should not use this: add them in
+/// activatedAbilities and the gate stops matching. Write it out instead.
+class EmpoweredSelfBuff : public UnitCard {
+public:
+    std::vector<ActivatedAbility> activatedAbilities() const override {
+        return {empowerAbility(empowerCost())};
+    }
+
+    bool canActivateAbility(const GameState& state, PlayerId /*controller*/,
+                            GameObjectId self, int ability_index) const override {
+        return empowerGate(state, self, ability_index, /*empower_index=*/0, {});
+    }
+
+    void onActivate(CardContext& ctx, int ability_index,
+                    const std::vector<GameObjectId>&) override {
+        if (ability_index == 0) empowerObject(ctx, ctx.source);
+    }
+
+    void applyPassiveAura(GameState& state, PlayerId /*controller*/,
+                          GameObjectId self) const override {
+        if (!state.objectExists(self)) return;
+        auto& obj = state.getObject(self);
+        if (!obj.is_empowered) return;
+        // Push AuraEffects rather than writing aura_might_bonus directly.
+        // recalculateAuras aggregates aura_effects into the caches in a LATER
+        // step and recomputes Might there; writing the cache here would be
+        // overwritten by that aggregation, which looks like the buff simply
+        // not existing.
+        for (auto ae : empoweredAuras()) {
+            ae.source = self;
+            obj.aura_effects.push_back(ae);
+        }
+    }
+
+protected:
+    /// What [Empower] costs on this card.
+    virtual ActivationCost empowerCost() const = 0;
+    /// What "[Empowered][>] I have …" grants, as aura effects on itself.
+    virtual std::vector<GameObject::AuraEffect> empoweredAuras() const = 0;
+};
