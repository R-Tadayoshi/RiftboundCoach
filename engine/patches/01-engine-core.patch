+/// Empowered if it's not already" — so empowering twice is not an error and
+/// must not be logged as one.
+inline void empowerObject(CardContext& ctx, GameObjectId id) {
+    if (!ctx.state.objectExists(id)) return;
+    auto& obj = ctx.state.getObject(id);
+    if (obj.is_empowered) return;
+    obj.is_empowered = true;
+    ctx.events.logTrace("EMPOWER: " + obj.name + " (id=" + std::to_string(id) +
