+inline void disempowerObject(CardContext& ctx, GameObjectId id) {
+    if (!ctx.state.objectExists(id)) return;
+    auto& obj = ctx.state.getObject(id);
+    if (!obj.is_empowered) return;
+    obj.is_empowered = false;
+    ctx.events.logTrace("DISEMPOWER: " + obj.name + " (id=" + std::to_string(id) + ")");
