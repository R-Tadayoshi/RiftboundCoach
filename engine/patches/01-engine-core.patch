+        if (pid != e.player) continue;
+        auto legend_id = state_.player(pid).legend_zone;
+        if (legend_id == kInvalidId || legend_id == e.object) continue;
+        if (!state_.objectExists(legend_id)) continue;
+        auto& legend = state_.getObject(legend_id);
+        if (cardFiresOn(card_registry_, legend.card_def_id,
+                        TriggerType::WhenYouEmpowerSomethingElse)) {
+            fireTrigger(legend_id, pid, 0, TriggerType::WhenYouEmpowerSomethingElse);
+        }
+    }
+}
