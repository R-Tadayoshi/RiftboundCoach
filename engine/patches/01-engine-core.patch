+                        TriggerType::WhenYouEmpowerSomethingElse)) {
+            fireTrigger(id, e.player, 0, TriggerType::WhenYouEmpowerSomethingElse);
+        }
+    }
+    // …and the self-scoped form, to the object that just became Empowered.
+    if (state_.objectExists(e.object)) {
+        auto& self = state_.getObject(e.object);
+        if (cardFiresOn(card_registry_, self.card_def_id,
+                        TriggerType::WhenIBecomeEmpowered)) {
+            fireTrigger(e.object, self.controller, 0,
+                        TriggerType::WhenIBecomeEmpowered);
+        }
+    }
+    // Legends sit in the legend zone with no location, so the loop above
+    // cannot see them — and both cards that want this trigger ARE legends.
