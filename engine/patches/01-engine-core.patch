+void EffectExecutor::burnCards(PlayerId player, int count) {
+    auto& ps = state_.player(player);
+    events_.logTrace(std::string("EFFECT: ") + toString(player) + " burns " +
+                     std::to_string(count) + " (deck=" +
+                     std::to_string(ps.main_deck.size()) + ")");
+
+    int burned = 0;
+    for (int i = 0; i < count; ++i) {
+        // An empty deck stops the burn. It does NOT trigger burn-out: CR
+        // 431.2 fires when a DRAW finds the deck empty, and burning is not
+        // drawing.
+        if (ps.main_deck.empty()) break;
+        auto card_id = ps.main_deck.back();
+        ps.main_deck.pop_back();
+        ps.trash.push_back(card_id);
+        state_.getObject(card_id).zone = ZoneType::Trash;
+        events_.logTrace("  BURNED: " + state_.getObject(card_id).name +
+                         " (id=" + std::to_string(card_id) + ")");
+        ++burned;
+    }
+    if (burned < count) {
+        events_.logTrace("  burn stopped short: deck exhausted after " +
+                         std::to_string(burned));
+    }
+}
