+/// "You may pay [rune] to …" — POWER paid from a card's own effect.
+///
+/// Power is not energy, and this is not payEnergyFromRunes with a different
+/// number. CR 164.2 pays energy by EXHAUSTING a ready rune and power by
+/// RECYCLING one — sending it back to the rune deck — so the two helpers
+/// leave the board in different states, and a card that paid power by
+/// exhausting would keep a rune it should have spent.
+///
+/// Mirrors the engine's own power step (GameEngine::resolveCostPaymentDecision,
+/// Phase::PayingPower): recycle to the TOP of the rune deck, clear exhaustion
+/// on the way out, emit LeftBoardEvent, and count it towards
+/// power_spent_this_turn — Sivir, Mercenary reads that counter, and a power
+/// payment this helper made must be as visible to her as one the engine made.
+///
+/// Already-exhausted runes are spent first, deliberately: a ready rune is
+/// worth more (it can still pay energy), and the engine's own ordering lets
+/// one rune pay energy and then power in the same cost. Taking the ready
+/// ones first would quietly cost the player a point of energy.
+///
+/// `domains` filters to runes of those domains, which is what a coloured
+/// symbol means. Pass an empty list for a rainbow symbol — any rune.
+///
+/// Returns false and recycles nothing when the player cannot cover the whole
+/// cost, so a partial payment can never happen.
+inline bool payPowerFromRunes(CardContext& ctx, int count,
+                              const std::vector<Domain>& domains) {
+    if (count <= 0) return true;
+    const auto base = BaseLocation{ctx.controller};
+
+    std::vector<GameObjectId> exhausted, ready;
+    for (auto& [id, obj] : ctx.state.objects) {
+        if (!obj.isRune() || obj.controller != ctx.controller) continue;
+        if (!obj.location.has_value() || *obj.location != LocationId{base}) continue;
+        if (!domains.empty()) {
+            bool match = false;
+            for (auto d : domains) {
+                for (auto rd : obj.domains) {
+                    if (d == rd) { match = true; break; }
+                }
+                if (match) break;
+            }
+            if (!match) continue;
+        }
+        (obj.is_exhausted ? exhausted : ready).push_back(id);
+    }
+    if (static_cast<int>(exhausted.size() + ready.size()) < count) return false;
+
+    auto& ps = ctx.state.player(ctx.controller);
+    auto recycle = [&](GameObjectId id) {
+        auto& rune = ctx.state.getObject(id);
+        ctx.events.logTrace("  RECYCLE_RUNE: " + rune.name + " (id=" +
+                             std::to_string(id) + ") for power [card effect]");
+        rune.location = std::nullopt;
+        rune.zone = ZoneType::RuneDeck;
+        rune.is_exhausted = false;
+        ps.rune_deck.insert(ps.rune_deck.begin(), id);
+        ctx.events.emit(LeftBoardEvent{id, ctx.controller, CardType::Rune,
+                                        base, ZoneType::RuneDeck, false});
+        ps.power_spent_this_turn++;
+    };
+
+    int left = count;
+    for (auto id : exhausted) { if (left == 0) break; recycle(id); --left; }
+    for (auto id : ready)     { if (left == 0) break; recycle(id); --left; }
+    return true;
+}
+
+/// Whether payPowerFromRunes would succeed, without spending anything.
+/// Cards ask this before offering an optional payment, so the agent is
+/// never shown a "you may pay [rune]" it cannot pay.
+inline bool canPayPowerFromRunes(const GameState& state, PlayerId controller,
+                                  int count, const std::vector<Domain>& domains) {
+    if (count <= 0) return true;
+    const auto base = BaseLocation{controller};
+    int n = 0;
+    for (const auto& [id, obj] : state.objects) {
+        if (!obj.isRune() || obj.controller != controller) continue;
+        if (!obj.location.has_value() || *obj.location != LocationId{base}) continue;
+        if (!domains.empty()) {
+            bool match = false;
+            for (auto d : domains) {
+                for (auto rd : obj.domains) {
+                    if (d == rd) { match = true; break; }
+                }
+                if (match) break;
+            }
+            if (!match) continue;
+        }
+        ++n;
+    }
+    return n >= count;
+}
+
+/// "If you control fewer runes than an opponent" — the VEN catch-up clause
+/// (Forsaken Baccai, Oasis Raider, and the [Empower] discounts that scale
+/// with rune count).
+///
+/// Runes ON THE BOARD that you control. A rune in hand is not one you
+/// control, and an exhausted rune still is — the clause counts how many you
+/// have, not how many you can spend, which is the same distinction that
+/// makes power cost recycle an exhausted rune rather than exhaust a ready
+/// one.
+///
+/// "Fewer than AN opponent" is fewer than any single one of them, so a strict
+/// comparison against each in turn rather than against their total.
+inline int runesControlled(const GameState& state, PlayerId player) {
+    int n = 0;
+    for (const auto& [id, obj] : state.objects) {
+        if (!obj.isRune() || obj.controller != player) continue;
+        if (!obj.location.has_value()) continue;
+        ++n;
+    }
+    return n;
+}
