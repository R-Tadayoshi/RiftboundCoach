+                ss << nameOf(state, units_to_move[i]);
+            }
+            if (move_destination.has_value()) {
+                ss << " -> " << whereIs(state, *move_destination);
+            }
+            break;
+        }
+        case IntentType::MulliganDecision:
+            ss << " [" << cards_to_mulligan.size() << " cards]";
+            break;
+        case IntentType::AssignCombatDamage:
+            ss << " [" << damage_assignments.size() << " assignments]";
+            break;
+        case IntentType::PlayFirstDecision:
+            ss << " [" << (choose_first ? "first" : "second") << "]";
+            break;
+        default:
+            if (card != kInvalidId) ss << " " << nameOf(state, card);
+            if (ability_source != kInvalidId && ability_source != card) {
+                ss << " (" << nameOf(state, ability_source) << ")";
+            }
+            if (play_location.has_value()) {
+                ss << " to " << whereIs(state, *play_location);
+            }
+            if (!targets.empty()) {
+                ss << " on ";
+                for (size_t i = 0; i < targets.size(); ++i) {
+                    if (i) ss << ", ";
+                    ss << nameOf(state, targets[i]);
+                }
+            }
+            break;
+    }
+
+    return ss.str();
+}
