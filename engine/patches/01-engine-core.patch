+namespace {
+/// Where pickTargets keeps its bookkeeping in ChainItem::resume_data.
+/// 0..4 are spoken for by pickXAmount (0), pickMode (1), pickTarget (2) and
+/// pickTargetPair (3..4), so this starts clear of all of them.
+constexpr size_t kPickTargetsCount = 5;   // how many picked so far
+constexpr size_t kPickTargetsDone  = 6;   // 1 once picking has finished
+constexpr size_t kPickTargetsBase  = 7;   // picks themselves, one per slot
+constexpr int    kPickTargetsPoint = 20;  // first resume point
+}  // namespace
+
+std::optional<std::vector<GameObjectId>> Card::pickTargets(
+    CardContext& ctx, const std::string& label,
+    const std::function<std::vector<GameObjectId>(
+        const std::vector<GameObjectId>&)>& legal_fn,
+    int max_count, bool optional) {
+
+    auto& ri_opt = ctx.state.chain.resuming;
+    if (!ri_opt.has_value()) {
+        // Direct invocation (test / no chain), same escape hatch the other
+        // pickers use: take the first legal option at each step.
+        std::vector<GameObjectId> out;
+        for (int k = 0; k < max_count; ++k) {
+            auto legal = legal_fn(out);
+            if (legal.empty()) break;
+            out.push_back(legal.front());
+        }
+        return out;
+    }
+    auto& ri = *ri_opt;
+
+    while (ri.resume_data.size() <
+           kPickTargetsBase + static_cast<size_t>(std::max(0, max_count))) {
+        ri.resume_data.push_back(0);
+    }
+
+    auto picked_so_far = [&]() {
+        std::vector<GameObjectId> out;
+        const int n = ri.resume_data[kPickTargetsCount];
+        for (int i = 0; i < n; ++i) {
+            out.push_back(static_cast<GameObjectId>(
+                ri.resume_data[kPickTargetsBase + static_cast<size_t>(i)]));
+        }
+        return out;
+    };
+
+    // Already finished on an earlier pass through onResolve. Re-entry must
+    // hand back the same picks rather than prompt again — the card may have
+    // suspended on something else after this call.
+    if (ri.resume_data[kPickTargetsDone] != 0) return picked_so_far();
+
+    auto finish = [&]() {
+        ri.resume_data[kPickTargetsDone] = 1;
+        return picked_so_far();
+    };
+
+    if (ri.resume_point < kPickTargetsPoint) {
+        ri.resume_point = kPickTargetsPoint;
+        ri.resume_data[kPickTargetsCount] = 0;
+    }
+
+    for (;;) {
+        const int slot = ri.resume_data[kPickTargetsCount];
+        if (slot >= max_count) return finish();
+
+        const int publish_at = kPickTargetsPoint + 2 * slot;
+        const int consume_at = publish_at + 1;
+
+        if (ri.resume_point == publish_at) {
+            auto so_far = picked_so_far();
+            auto legal = legal_fn(so_far);
+            if (legal.empty()) {
+                ctx.events.logTrace("TGTS_DONE: " + label +
+                                     " (no further legal targets after " +
+                                     std::to_string(slot) + ")");
+                return finish();
+            }
+
+            std::vector<Intent> options;
+            options.reserve(legal.size() + 1);
+            std::string summary;
+            for (auto t : legal) {
+                Intent i;
+                i.type = IntentType::MakeChoice;
+                i.player = ctx.controller;
+                i.chosen_objects = { t };
+                i.choice_label = label + ": " +
+                    (ctx.state.objectExists(t) ? ctx.state.getObject(t).name
+                                               : std::string("?"));
+                options.push_back(std::move(i));
+                if (!summary.empty()) summary += "/";
+                summary += ctx.state.objectExists(t)
+                    ? ctx.state.getObject(t).name : std::string("?");
+            }
+            // "Up to N" — a stop option on every prompt, the first
+            // included. Without it the card would read as "exactly N", and
+            // without it at slot 0 it would read as "at least 1".
+            // Empty chosen_objects is action_vocab slot 0 ("skip"), which is
+            // distinct from every card-keyed slot, so the policy head can
+            // tell stopping apart from any particular pick. chosen_value is
+            // deliberately left unset: setting it would move this option
+            // into the int-coded range where it could alias a pickXAmount
+            // answer.
+            if (optional) {
+                Intent stop;
+                stop.type = IntentType::MakeChoice;
+                stop.player = ctx.controller;
+                stop.choice_label = label + ": stop here";
+                options.push_back(std::move(stop));
+            }
+            ctx.events.logTrace("TGTS_PROMPT: " + label + " [" + summary +
+                                 "] pick " + std::to_string(slot + 1) +
+                                 " of at most " + std::to_string(max_count));
+            ctx.executor.requestChoice(ctx.controller, std::move(options),
+                                        "targets: " + label);
+            ri.resume_point = consume_at;
+            return std::nullopt;   // suspended
+        }
+
+        if (ri.resume_point == consume_at) {
+            auto picked = ctx.executor.takeChoice();
+            if (!picked.has_value() || picked->chosen_objects.empty()) {
+                // The stop option, or nothing came back.
+                ctx.events.logTrace("TGTS_STOPPED: " + label + " after " +
+                                     std::to_string(slot) + " pick(s)");
+                return finish();
+            }
+            const auto t = picked->chosen_objects.front();
+            ctx.events.logTrace("TGTS_PICKED: " + label + " = " +
+                                 (ctx.state.objectExists(t)
+                                      ? ctx.state.getObject(t).name
+                                      : std::string("?")) +
+                                 " (id=" + std::to_string(t) + ")");
+            ri.resume_data[kPickTargetsBase + static_cast<size_t>(slot)] =
+                static_cast<int32_t>(t);
+            ri.resume_data[kPickTargetsCount] = slot + 1;
+            ri.resume_point = kPickTargetsPoint + 2 * (slot + 1);
+            continue;   // straight on to the next prompt
+        }
+
+        // The resume point and the count have diverged, which should not
+        // happen. Hand back what we have rather than spin or re-prompt.
+        ctx.events.logTrace("TGTS_DESYNC: " + label + " (point=" +
+                             std::to_string(ri.resume_point) + ", slot=" +
+                             std::to_string(slot) + ")");
+        return finish();
+    }
+}
