-    if (ctx.state.chain.items.empty()) return;
+/// Whether this chain item may legally be countered.
+///
+/// Fails open on purpose. A chain item with no CardDef (a token's ability,
+/// an engine-made effect) has no card to ask, and an executor with no
+/// CardRegistry cannot ask; in both cases the answer is "yes, counter it",
+/// which is exactly what every counterspell did before this existed. Only a
+/// card that answers false — Card::canBeCountered — changes anything.
+inline bool chainItemCanBeCountered(CardContext& ctx, const ChainItem& item) {
+    if (item.card_def_id == kInvalidId) return true;
+    const CardRegistry* reg = ctx.executor.cardRegistry();
+    if (!reg) return true;
+    const Card* card = reg->get(item.card_def_id);
+    return !card || card->canBeCountered();
+}
+
+/// Counter the top chain item. Returns whether it was actually countered, so
+/// callers with a rider ("counter it AND they can't play spells this turn")
+/// can skip the rider when the counter fizzled.
+inline bool counterChainTop(CardContext& ctx) {
+    if (ctx.state.chain.items.empty()) return false;
     auto& top = ctx.state.chain.items.back();
-    if (!top.is_spell) return;
+    if (!top.is_spell) return false;
+    if (!chainItemCanBeCountered(ctx, top)) {
+        ctx.events.logTrace("COUNTER: " + std::to_string(top.source) +
+                             " cannot be countered");
+        return false;
+    }
     auto countered = top.source;
     revertCounteredPlay(ctx, top);  // CR 425.1.b
     ctx.state.chain.items.pop_back();
