+bool GameEngine::payFlowCost(PlayerId player, GameObjectId card_id) {
+    if (!state_.objectExists(card_id)) return false;
+    auto& card = state_.getObject(card_id);
+    if (card.card_def_id == kInvalidId) return false;
+    const Card* cdef = card_registry_.get(card.card_def_id);
+    if (!cdef) return false;
+    const auto flow = cdef->flowCost();
+    if (!flow.valid) return false;
+
+    Domain domain = flow.power_domain;
+    if (flow.any_domain) {
+        bool found = false;
+        for (int di = 0; di < static_cast<int>(Domain::Count); ++di) {
+            if (canPayAdditionalCost(player, flow.energy, flow.power,
+                                      static_cast<Domain>(di))) {
+                domain = static_cast<Domain>(di); found = true; break;
+            }
+        }
+        if (!found) return false;  // action gen should have filtered this out
+    }
+    const bool ok = payAdditionalCost(player, flow.energy, flow.power, domain);
+
+    // Marked here, not after resolving. "Then banish it" is part of the Flow
+    // play itself, so it must hold even if the spell is countered or fizzles
+    // — otherwise a countered Flow spell returns to the trash and can be
+    // played again, which is the opposite of what the mechanic costs.
+    card.banish_after_resolving = true;
+    events_.logTrace(std::string("FLOW: played ") + card.name +
+                     " from trash" + (ok ? "" : " (cost underpaid)"));
+    return true;
+}
