diff --git a/tests/cards/test_counter_spells.cpp b/tests/cards/test_counter_spells.cpp
index fa5b467..980bd9e 100644
--- a/tests/cards/test_counter_spells.cpp
+++ b/tests/cards/test_counter_spells.cpp
@@ -399,4 +399,260 @@ TEST_F(AbandonTest, ReturnsCounteredSpellToHand) {
     (void)deck_top;
 }
 
+
+// ═══════════════════════════════════════════════════════════════════════════
+// "This can't be countered" — Card::canBeCountered
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// Decree of Rage (802) is the first card to answer false. The guard lives in
+// chainItemCanBeCountered() (cards/card_helpers.h) and is consulted by every
+// counter path, so these tests are as much about the seven counterspells
+// above as they are about Decree of Rage.
+//
+// Note which EffectExecutor each test builds. The guard needs a CardRegistry
+// to ask the card anything, and the executor's registry is optional: a real
+// game always has one (GameEngine passes &card_registry_ at construction),
+// while most tests here construct `EffectExecutor(state, events, card_db)`
+// and get a null one. With no registry the guard fails open — counters behave
+// exactly as they did before it existed — which is why every test above still
+// passes untouched. FailsOpenWithoutARegistry pins that deliberately, so the
+// day someone "fixes" it into a fail-closed check, a test says so.
+
+constexpr CardDefId kDecreeOfRage = 802;
+
+class UncounterableTest : public CardTestFixture {};
+
+TEST_F(UncounterableTest, WindWallCannotCounterDecreeOfRage) {
+    auto target = pushSpellOnChain(P2, kDecreeOfRage);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kWindWall, P1, {}, exec);
+
+    ASSERT_EQ(state.chain.items.size(), 1u)
+        << "Decree of Rage can't be countered — it must stay on the chain";
+    EXPECT_EQ(state.chain.items.back().source, target);
+    EXPECT_NE(state.getObject(target).zone, ZoneType::Trash);
+    EXPECT_FALSE(inTrash(P2, target));
+}
+
+TEST_F(UncounterableTest, WindWallStillCountersAnOrdinarySpell) {
+    // The guard must not become a blanket "nothing counters". Same executor,
+    // same card, a spell that has no objection.
+    auto target = pushSpellOnChain(P2, kLunarBoon);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kWindWall, P1, {}, exec);
+
+    EXPECT_TRUE(state.chain.items.empty());
+    EXPECT_EQ(state.getObject(target).zone, ZoneType::Trash);
+}
+
+TEST_F(UncounterableTest, FailsOpenWithoutARegistry) {
+    auto target = pushSpellOnChain(P2, kDecreeOfRage);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db);  // deliberately no registry
+    invokeOnResolve(src, kWindWall, P1, {}, exec);
+
+    EXPECT_TRUE(state.chain.items.empty())
+        << "with no registry the guard cannot ask, so it must fail OPEN and "
+           "leave pre-existing counter behaviour unchanged";
+    EXPECT_EQ(state.getObject(target).zone, ZoneType::Trash);
+}
+
+TEST_F(UncounterableTest, LullabyRiderDoesNotApplyWhenCounterFizzles) {
+    // "Counter a spell. Its controller can't play spells this turn." The
+    // rider rides on the counter: no counter, no rider.
+    pushSpellOnChain(P2, kDecreeOfRage);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kLullaby, P1, {}, exec);
+
+    EXPECT_EQ(state.chain.items.size(), 1u);
+    EXPECT_FALSE(state.player(P2).cant_play_spells_this_turn)
+        << "the counter fizzled, so its rider must not land either";
+}
+
+TEST_F(UncounterableTest, DefyCannotCounterDecreeOfRage) {
+    // Defy gates on cost ("no more than [4]"); Decree of Rage costs 1, so it
+    // passes that gate and only canBeCountered can stop it.
+    auto target = pushSpellOnChain(P2, kDecreeOfRage);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kDefy, P1, {}, exec);
+
+    EXPECT_EQ(state.chain.items.size(), 1u);
+    EXPECT_NE(state.getObject(target).zone, ZoneType::Trash);
+}
+
+// ═══════════════════════════════════════════════════════════════════════════
+// Decree of Rage (802) — the other half: deal 4 to an enemy Calm unit
+// ═══════════════════════════════════════════════════════════════════════════
+
+class DecreeOfRageTest : public CardTestFixture {};
+
+TEST_F(DecreeOfRageTest, TargetsOnlyEnemyCalmUnits) {
+    auto enemy_calm = addUnit(P2, kInvalidId, 5);
+    state.getObject(enemy_calm).domains = {Domain::Calm};
+    auto enemy_fury = addUnit(P2, kInvalidId, 5);
+    state.getObject(enemy_fury).domains = {Domain::Fury};
+    auto own_calm = addUnit(P1, kInvalidId, 5);
+    state.getObject(own_calm).domains = {Domain::Calm};
+
+    Card* c = card_registry.get(kDecreeOfRage);
+    auto legal = c->enumerateLegalTargets(state, P1);
+
+    ASSERT_EQ(legal.size(), 1u);
+    EXPECT_EQ(legal[0], enemy_calm);
+    EXPECT_TRUE(c->hasLegalTargets(state, P1));
+}
+
+TEST_F(DecreeOfRageTest, NotPlayableWithNoEnemyCalmUnit) {
+    auto enemy_fury = addUnit(P2, kInvalidId, 5);
+    state.getObject(enemy_fury).domains = {Domain::Fury};
+
+    Card* c = card_registry.get(kDecreeOfRage);
+    EXPECT_FALSE(c->hasLegalTargets(state, P1));
+}
+
+TEST_F(DecreeOfRageTest, SkipsUnitsUntargetableByTheEnemy) {
+    auto shy = addUnit(P2, kInvalidId, 5);
+    state.getObject(shy).domains = {Domain::Calm};
+    state.getObject(shy).untargetable_by_enemy = true;
+
+    Card* c = card_registry.get(kDecreeOfRage);
+    EXPECT_TRUE(c->enumerateLegalTargets(state, P1).empty());
+}
+
+TEST_F(DecreeOfRageTest, DealsFour) {
+    auto victim = addUnit(P2, kInvalidId, 6);
+    state.getObject(victim).domains = {Domain::Calm};
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kDecreeOfRage, P1, {victim}, exec);
+
+    EXPECT_EQ(state.getObject(victim).damage_marked, 4);
+}
+
+
+// ═══════════════════════════════════════════════════════════════════════════
+// Crumbling Sands (826) — counter, conditional on the opponent's turn history
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// "Counter a spell if an opponent has played another spell this turn." The
+// condition is about what they did, not about what is on the chain: the spell
+// being countered may be their second, or it may be their first with an
+// earlier one already resolved and gone. So it reads
+// GameState::spellsPlayedThisTurn, which cards_played_this_turn could not
+// answer — a unit increments that too.
+
+constexpr CardDefId kCrumblingSands = 826;
+
+class CrumblingSandsTest : public CardTestFixture {};
+
+TEST_F(CrumblingSandsTest, NotPlayableWhenTheOpponentHasPlayedNoSpell) {
+    pushSpellOnChain(P2, kLunarBoon);   // on the chain, but not yet "played"
+    Card* c = card_registry.get(kCrumblingSands);
+    EXPECT_FALSE(c->hasLegalTargets(state, P1));
+}
+
+TEST_F(CrumblingSandsTest, NotPlayableWithNoSpellOnTheChain) {
+    state.notePlayedSpell(P2);
+    Card* c = card_registry.get(kCrumblingSands);
+    EXPECT_FALSE(c->hasLegalTargets(state, P1))
+        << "the condition holds but there is nothing to counter";
+}
+
+TEST_F(CrumblingSandsTest, PlayableWhenBothHold) {
+    state.notePlayedSpell(P2);
+    pushSpellOnChain(P2, kLunarBoon);
+    Card* c = card_registry.get(kCrumblingSands);
+    EXPECT_TRUE(c->hasLegalTargets(state, P1));
+}
+
+TEST_F(CrumblingSandsTest, MyOwnSpellsDoNotSatisfyTheCondition) {
+    state.notePlayedSpell(P1);
+    pushSpellOnChain(P2, kLunarBoon);
+    Card* c = card_registry.get(kCrumblingSands);
+    EXPECT_FALSE(c->hasLegalTargets(state, P1))
+        << "\"an OPPONENT has played another spell\"";
+}
+
+TEST_F(CrumblingSandsTest, CountersWhenTheConditionHolds) {
+    state.notePlayedSpell(P2);
+    auto target = pushSpellOnChain(P2, kLunarBoon);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kCrumblingSands, P1, {}, exec);
+
+    EXPECT_TRUE(state.chain.items.empty());
+    EXPECT_EQ(state.getObject(target).zone, ZoneType::Trash);
+}
+
+TEST_F(CrumblingSandsTest, DoesNothingWhenTheConditionDoesNot) {
+    auto target = pushSpellOnChain(P2, kLunarBoon);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kCrumblingSands, P1, {}, exec);
+
+    EXPECT_EQ(state.chain.items.size(), 1u);
+    EXPECT_NE(state.getObject(target).zone, ZoneType::Trash);
+}
+
+TEST_F(CrumblingSandsTest, RespectsCanBeCountered) {
+    state.notePlayedSpell(P2);
+    pushSpellOnChain(P2, kDecreeOfRage);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kCrumblingSands, P1, {}, exec);
+
+    EXPECT_EQ(state.chain.items.size(), 1u);
+}
+
+// A count from an earlier turn is not "this turn".
+//
+// resetTurnTracking() runs for the turn player only, so the non-turn player's
+// per-turn counters survive into their opponent's turn. That is precisely the
+// window in which reactions get played, so a plain counter would have made
+// Crumbling Sands read last turn's history as this turn's.
+TEST_F(CrumblingSandsTest, AStaleCountDoesNotCarryIntoTheNextTurn) {
+    state.turn.turn_number = 4;
+    state.notePlayedSpell(P2);
+    EXPECT_EQ(state.spellsPlayedThisTurn(P2), 1);
+
+    state.turn.turn_number = 5;
+    EXPECT_EQ(state.spellsPlayedThisTurn(P2), 0)
+        << "the count is stamped with its turn; an older one reads as zero";
+
+    pushSpellOnChain(P2, kLunarBoon);
+    Card* c = card_registry.get(kCrumblingSands);
+    EXPECT_FALSE(c->hasLegalTargets(state, P1));
+}
+
 }  // namespace
diff --git a/tests/cards/test_flow.cpp b/tests/cards/test_flow.cpp
new file mode 100644
index 0000000..d4beb4c
--- /dev/null
+++ b/tests/cards/test_flow.cpp
@@ -0,0 +1,84 @@
+/// @file test_flow.cpp
+/// [Flow] — "You may play this from your trash for its Flow cost. Then
+/// banish it."
+///
+/// The banish is the mechanic's entire cost. A Flow card is one extra use,
+/// not a loop, and every way the test file below can think of to get the card
+/// back into the trash is a way to turn it into one.
+
+#include "tests/cards/card_test_fixture.h"
+
+using namespace riftbound;
+using namespace riftbound::test;
+
+namespace {
+
+constexpr CardDefId kDredgeUp       = 836;  // Draw 1.        [Flow] [2]
+constexpr CardDefId kTwilightShroud = 818;  // +1[M], untgt.  [Flow] [2]
+constexpr CardDefId kUpFromTheDeep  = 887;  // two Tentacles. [Flow] [3]
+
+class FlowTest : public CardTestFixture {};
+
+TEST_F(FlowTest, CardsDeclareTheirFlowCost) {
+    EXPECT_TRUE(card_registry.get(kDredgeUp)->flowCost().valid);
+    EXPECT_EQ(card_registry.get(kDredgeUp)->flowCost().energy, 2);
+    EXPECT_EQ(card_registry.get(kUpFromTheDeep)->flowCost().energy, 3);
+}
+
+TEST_F(FlowTest, AnOrdinarySpellDoesNot) {
+    // 687 Lunar Boon — no Flow. The default must stay invalid, or every spell
+    // in the game becomes playable from the trash.
+    EXPECT_FALSE(card_registry.get(687)->flowCost().valid);
+}
+
+TEST_F(FlowTest, DredgeUpDrawsOnResolve) {
+    auto deck_a = addToDeck(P1, kDredgeUp);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kDredgeUp, P1, {}, exec);
+
+    EXPECT_EQ(state.player(P1).hand.size(), 1u);
+    (void)deck_a;
+}
+
+TEST_F(FlowTest, UpFromTheDeepMakesTwoExhaustedTentacles) {
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kUpFromTheDeep, P1, {}, exec);
+
+    int tentacles = 0, ready = 0;
+    for (auto& [id, obj] : state.objects) {
+        if (obj.name != "Tentacle") continue;
+        ++tentacles;
+        if (!obj.is_exhausted) ++ready;
+        EXPECT_EQ(obj.current_might, 1);
+        EXPECT_EQ(obj.controller, P1);
+    }
+    EXPECT_EQ(tentacles, 2);
+    EXPECT_EQ(ready, 0) << "units enter exhausted (CR 143.4); the card grants no exception";
+}
+
+// The one that matters: a granted this-turn untargetability must survive the
+// aura pass that rebuilds untargetable_by_enemy from scratch.
+TEST_F(FlowTest, TwilightShroudUsesTheThisTurnFieldNotTheDerivedOne) {
+    auto unit = addUnit(P1, kInvalidId, 3);
+    auto src = state.createObject();
+    state.getObject(src).owner = P1;
+    state.getObject(src).controller = P1;
+
+    EffectExecutor exec(state, events, card_db, &card_registry);
+    invokeOnResolve(src, kTwilightShroud, P1, {unit}, exec);
+
+    EXPECT_TRUE(state.getObject(unit).untargetable_by_enemy_this_turn)
+        << "writing the derived flag instead would be silently undone by the "
+           "next recalculateAuras, inside the same turn it was paid for";
+    EXPECT_EQ(state.getObject(unit).current_might, 4);
+}
+
+}  // namespace
